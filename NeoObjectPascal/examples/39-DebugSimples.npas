// Exemplo simples para testar o debugger

var x: Integer;
var y: Integer;
var resultado: Integer;

begin
    x := 10;
    y := 20;
    resultado := x + y;
    WriteLn("x = ", x);
    WriteLn("y = ", y);
    WriteLn("resultado = ", resultado);
    
    x := x * 2;
    y := y + 5;
    resultado := x - y;
    WriteLn("Novo resultado = ", resultado);
end.
